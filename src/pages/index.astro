---
import { getCollection } from 'astro:content';
import { Sparkles } from 'lucide-react';
import MainLayout from '../layouts/MainLayout.astro';
import RecipeCatalog, { type CatalogRecipe } from '../components/RecipeCatalog';

const recipeEntries = await getCollection('recipes');

const catalogRecipes: CatalogRecipe[] = recipeEntries
  .map((entry) => {
    const { data } = entry;
    const mainImage = data.images.find((img) => img.isMain) ?? data.images[0];
    const ingredientNames = Array.from(
      new Set(
        data.ingredientGroups.flatMap((group) =>
          group.items.map((item) => item.name)
        )
      )
    );

    return {
      slug: data.slug || entry.id,
      title: data.title,
      summary: data.summary,
      category: data.category,
      tags: data.tags,
      totalTimeMinutes: data.totalTimeMinutes,
      difficulty: data.difficulty,
      images: mainImage ? [mainImage] : [],
      videos: data.videos.length > 0 ? [data.videos[0]] : [],
      ingredientNames,
      sourceDomain: data.sourceDomain,
      createdAt: data.createdAt,
    };
  })
  .sort((a, b) => Date.parse(b.createdAt) - Date.parse(a.createdAt));
---

<MainLayout title="Ulubione przepisy Kasi">
  <!-- Hero Section -->
  <section class="pt-2 pb-6 sm:pt-6 sm:pb-8">
    <div class="max-w-3xl">
      <div class="mb-3 inline-flex items-center gap-2 rounded-full bg-[#4A6B53]/10 px-3 py-1.5 text-xs font-semibold tracking-wide text-[#4A6B53] uppercase sm:mb-4">
        <Sparkles className="h-3.5 w-3.5" aria-hidden="true" />
        <span>Kulinarny notatnik domowy</span>
      </div>
      <h2 class="font-serif text-3xl font-bold leading-tight tracking-tight text-[#1F2421] sm:text-4xl lg:text-5xl">
        Najlepsze smaki zebrane w jednym miejscu.
      </h2>
      <p class="mt-3 text-base leading-relaxed font-normal text-[#1F2421]/70 sm:mt-4 sm:text-lg">
        Przepisy przetestowane, dopracowane i gotowe na wspólne gotowanie. Filtruj po kategoriach, szukaj po ulubionych składnikach i odkrywaj sprawdzone dania.
      </p>
    </div>
  </section>

  <!-- Interactive Cookbook Catalog -->
  <RecipeCatalog client:load recipes={catalogRecipes} />
</MainLayout>
