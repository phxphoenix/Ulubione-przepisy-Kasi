  "steps": [
    {
      "stepNumber": 1,
      "title": "Wstępne gotowanie kurczaka",
      "instruction": "W dużym garnku zagotuj 3 litry wody. Dodaj seler, ziarna czarnego pieprzu, główkę czosnku, sól, natkę pietruszki oraz zioła prowansalskie. Włóż całego kurczaka i gotuj go przez około 30 minut.",
      "tip": "Gotowanie w aromatycznym wywarze sprawi, że mięso będzie niezwykle soczyste w środku."
    },
    {
      "stepNumber": 2,
      "title": "Przygotowanie masła ziołowego",
      "instruction": "W miseczce wymieszaj miękkie masło z posiekaną pietruszką, przeciśniętym czosnkiem, ostrą papryką, solą oraz czarnym pieprzem, tworząc jednolitą pastę.",
      "tip": "Masło powinno być w temperaturze pokojowej, aby łatwo się rozprowadzało."
    },
    {
      "stepNumber": 3,
      "title": "Przygotowanie warzyw",
      "instruction": "Ziemniaki, marchewkę i cebulę obierz oraz pokrój na mniejsze kawałki. Wymieszaj je w misce z olejem, płatkami chili, solą oraz czarnym pieprzem.",
      "tip": "Warzywa równomiernie otoczone olejem i przyprawami lepiej się upieką."
    },
    {
      "stepNumber": 4,
      "title": "Formowanie i pieczenie",
      "instruction": "Wyjmij kurczaka z wywaru, natrzyj go przygotowanym masłem czosnkowym z każdej strony. Umieść kurczaka w naczyniu żaroodpornym wraz z przygotowanymi warzywami i piecz w piekarniku nagrzanym do 190°C przez około 45-60 minut, aż skórka będzie złocista i chrupiąca.",
      "tip": "Co jakiś czas możeszpolewać kurczaka wytapiającym się masłem."
    },
    {
      "stepNumber": 5,
      "title": "Przygotowanie sosu i podanie",
      "instruction": "W misce wymieszaj jogurt, posiekaną natkę pietruszki, sok z cytryny, miód, płatki chili, sól, pieprz, posiekany czosnek oraz pokrojone ogórki. Podawaj upieczonego kurczaka i warzywa z przygotowanym sosem.",
      "tip": "Sos świetnie orzeźwi maślanego, pieczonego kurczaka."
    }
  ],
  "chefTips": [
    "Przed pieczeniem upewnij się, że masło dotarło pod skórkę kurczaka, co zapewni największą soczystość piersi.",
    "Warzywa pieczone obok kurczaka przejmą jego wyjątkowy smak."
  ],
